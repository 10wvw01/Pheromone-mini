{
  "app_name": "ingest",
  "version": "0.6.0",
  "scheduler": {
    "delay_queue": {
      "enabled": false,
      "retry_interval_ms": 10,
      "max_wait_ms": 1000
    }
  },
  "functions": [
    {
      "so_name": "normalize.so",
      "func_name": "normalize",
      "resource": {
        "cpu_cores": 1,
        "memory_mb": 8
      }
    },
    {
      "so_name": "validate.so",
      "func_name": "validate",
      "resource": {
        "cpu_cores": 1,
        "memory_mb": 8
      }
    },
    {
      "so_name": "enrich.so",
      "func_name": "enrich",
      "resource": {
        "cpu_cores": 1,
        "memory_mb": 8
      }
    },
    {
      "so_name": "publish.so",
      "func_name": "publish",
      "resource": {
        "cpu_cores": 1,
        "memory_mb": 8
      }
    },
    {
      "so_name": "fallback.so",
      "func_name": "fallback",
      "resource": {
        "cpu_cores": 1,
        "memory_mb": 8
      }
    }
  ],
  "dependencies": [
    {
      "type": "DIRECT",
      "src_functions": [
        {
          "so_name": "validate.so",
          "func_name": "validate"
        }
      ],
      "tgt_functions": [
        "enrich"
      ]
    }
  ],
  "triggers": [
    {
      "bucket": "input",
      "trigger_name": "to_normalize",
      "primitive_type": "IMMEDIATE",
      "primitive": {
        "function": "normalize"
      }
    },
    {
      "bucket": "normalized",
      "trigger_name": "to_validate",
      "primitive_type": "BY_NAME",
      "primitive": {
        "function": "validate",
        "key_name": "ready"
      }
    },
    {
      "bucket": "enriched",
      "trigger_name": "to_publish",
      "primitive_type": "BY_NAME",
      "primitive": {
        "function": "publish",
        "key_name": "ready"
      }
    },
    {
      "bucket": "validated",
      "trigger_name": "to_fallback",
      "primitive_type": "IMMEDIATE",
      "primitive": {
        "function": "fallback"
      }
    }
  ]
}
